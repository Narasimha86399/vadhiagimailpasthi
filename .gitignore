# ==========================================
# Tannir Dictionary - .gitignore
# ==========================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak

# IDE & Editor Files
.idea/
.vscode/
*.swp
*.swo
*~

# Android Build Outputs & Caches
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/local.properties
android/*.iml
android/app/*.iml
android/.cxx/
android/captures/

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment and Local Overrides
.env
.env.local
